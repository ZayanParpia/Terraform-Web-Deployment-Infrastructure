            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"AllowALBLogDelivery\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::terraform-capstone-s3-logs/test-lb/AWSLogs/248179617249/*\",\n      \"Principal\": {\n        \"Service\": \"logdelivery.elasticloadbalancing.amazonaws.com\"\n      }\n    },\n    {\n      \"Sid\": \"AllowFlowLogsAclCheck\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetBucketAcl\",\n      \"Resource\": \"arn:aws:s3:::terraform-capstone-s3-logs\",\n      \"Principal\": {\n        \"Service\": \"delivery.logs.amazonaws.com\"\n      }\n    },\n    {\n      \"Sid\": \"AllowFlowLogsDelivery\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::terraform-capstone-s3-logs/AWSLogs/248179617249/*\",\n      \"Principal\": {\n        \"Service\": \"delivery.logs.amazonaws.com\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"s3:x-amz-acl\": \"bucket-owner-full-control\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"AllowALBLogDelivery\",\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::terraform-capstone-s3-logs/test-lb/AWSLogs/248179617249/*\",\"Principal\":{\"Service\":\"logdelivery.elasticloadbalancing.amazonaws.com\"}},{\"Sid\":\"AllowFlowLogsAclCheck\",\"Effect\":\"Allow\",\"Action\":\"s3:GetBucketAcl\",\"Resource\":\"arn:aws:s3:::terraform-capstone-s3-logs\",\"Principal\":{\"Service\":\"delivery.logs.amazonaws.com\"}},{\"Sid\":\"AllowFlowLogsDelivery\",\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::terraform-capstone-s3-logs/AWSLogs/248179617249/*\",\"Principal\":{\"Service\":\"delivery.logs.amazonaws.com\"},\"Condition\":{\"StringEquals\":{\"s3:x-amz-acl\":\"bucket-owner-full-control\"}}}]}",
